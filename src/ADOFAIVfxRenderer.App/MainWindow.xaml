<Window x:Class="ADOFAIVfxRenderer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADOFAI VFX Renderer"
        Width="1180"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <TabControl x:Name="MainTabs"
                Background="{StaticResource WindowBackground}"
                BorderThickness="0">
        <TabItem Header="渲染">
    <Grid Margin="20" Background="{StaticResource WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="ADOFAI VFX Renderer" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,18"
                           Foreground="{StaticResource TextSecondary}"
                           Text="独立 Unity Worker 驱动的离线 Video / Video Pro / Video VFX 渲染器" />

                <GroupBox Header="游戏安装">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GamePathBox" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Click="BrowseGame_Click" Content="选择目录" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Click="DetectGame_Click" Content="检测兼容性" />
                            <ComboBox x:Name="DetectedGamesBox"
                                      Width="235"
                                      Margin="8,0,0,0"
                                      SelectionChanged="DetectedGamesBox_SelectionChanged" />
                        </StackPanel>
                        <TextBlock x:Name="GameStatusText"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="尚未检测。用户只需选择游戏目录，无需寻找 Managed。" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="谱面">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChartPathBox" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Click="BrowseChart_Click" Content="选择谱面" />
                        </Grid>
                        <TextBlock x:Name="ChartStatusText"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="尚未选择 .adofai。" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="输出版本（可多选）">
                    <WrapPanel x:Name="ProfilesPanel" />
                </GroupBox>

                <GroupBox Header="渲染内容（高级）">
                    <StackPanel>
                        <CheckBox x:Name="UseProfileContentCheckBox"
                                  IsChecked="True"
                                  Click="UseProfileContent_Click"
                                  Content="使用版本预设（推荐）" />
                        <WrapPanel x:Name="ContentChecksPanel" Margin="0,9,0,0">
                            <CheckBox x:Name="BackgroundDecorationsCheckBox" Content="背景装饰" />
                            <CheckBox x:Name="ForegroundDecorationsCheckBox" Content="前景装饰" />
                            <CheckBox x:Name="TrackCheckBox"
                                      IsEnabled="False"
                                      ToolTip="原版轨道离线适配完成后开放。"
                                      Content="轨道（待适配）" />
                            <CheckBox x:Name="PlanetsCheckBox"
                                      IsEnabled="False"
                                      ToolTip="原版星球离线适配完成后开放。"
                                      Content="星球（待适配）" />
                            <CheckBox x:Name="EffectsCheckBox"
                                      IsEnabled="False"
                                      ToolTip="请在“滤镜与装饰 → 滤镜”中逐组选择实时、烤入或忽略。"
                                      Content="滤镜（请到滤镜页选择）" />
                        </WrapPanel>
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="UI 永远不会进入视频。取消版本预设后可自由组合；源谱面不会被修改。" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="分辨率（可多选）">
                    <WrapPanel x:Name="ResolutionsPanel" />
                </GroupBox>

                <GroupBox Header="输出 FPS（可多选）">
                    <WrapPanel x:Name="FrameRatesPanel" />
                </GroupBox>

                <GroupBox Header="结束后继续渲染">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TailSecondsBox"
                                     Width="90"
                                     Text="5"
                                     TextChanged="TailSecondsBox_TextChanged" />
                            <TextBlock Margin="8,0,14,0" Text="秒" />
                            <TextBox x:Name="TailFramesBox"
                                     Width="100"
                                     Text="300"
                                     TextChanged="TailFramesBox_TextChanged" />
                            <TextBlock Margin="8,0,0,0" Text="帧" />
                        </StackPanel>
                        <TextBlock x:Name="TailReferenceText"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondary}"
                                   Text="帧数按当前最高输出 FPS 换算。" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Margin="0,0,8,0" Click="TailPreset_Click" Tag="1" Content="1 秒" />
                            <Button Margin="0,0,8,0" Click="TailPreset_Click" Tag="3" Content="3 秒" />
                            <Button Margin="0,0,8,0" Click="TailPreset_Click" Tag="5" Content="5 秒" />
                            <Button Click="TailPreset_Click" Tag="10" Content="10 秒" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="批量优化">
                    <StackPanel>
                        <TextBlock Text="分辨率策略" />
                        <ComboBox x:Name="ResolutionStrategyBox" Margin="0,6,0,10" />
                        <TextBlock Text="计算 / 编码后端" />
                        <ComboBox x:Name="RenderBackendBox" Margin="0,6,0,6" />
                        <TextBlock x:Name="RenderBackendHelpText"
                                   Margin="0,0,0,10"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="自动选择稳定路径。CPU 模式使用 WARP 软件光栅；GPU/RTX 模式使用硬件编码。" />
                        <TextBlock Text="视频质量" />
                        <ComboBox x:Name="QualityBox"
                                  Margin="0,6,0,10"
                                  SelectionChanged="QualityBox_SelectionChanged" />
                        <TextBlock Text="自定义码率（kbps）" />
                        <TextBox x:Name="BitrateBox"
                                 Margin="0,6,0,0"
                                 Text="4000"
                                 IsEnabled="False" />
                    </StackPanel>
                </GroupBox>

                <Button Padding="18,11"
                        FontWeight="SemiBold"
                        Background="{StaticResource Accent}"
                        Foreground="#07111E"
                        Click="BuildPlan_Click"
                        Content="生成批量渲染计划" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="StartRenderButton"
                            Style="{StaticResource RenderActionButtonStyle}"
                            Click="StartRender_Click"
                            Content="开始离线渲染（首测 Video VFX）" />
                    <Button x:Name="CancelRenderButton"
                            Grid.Column="2"
                            Padding="16,11"
                            IsEnabled="False"
                            Click="CancelRender_Click"
                            Content="取消" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="400" />
                <RowDefinition Height="14" />
                <RowDefinition Height="220" MinHeight="160" />
            </Grid.RowDefinitions>

            <Border Background="#090B10" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="PreviewPlaceholder"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"
                               Text="离屏渲染预览&#x0a;这里将始终显示最新完成并送入编码器的帧" />
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="14"
                            Padding="9,5"
                            CornerRadius="4"
                            Background="#B012151B">
                        <TextBlock x:Name="WorkerStateText" Text="Worker 尚未启动" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="输出矩阵" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
                <ListView x:Name="OutputList"
                          Grid.Row="1"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          Background="{StaticResource PanelBackground}"
                          Foreground="{StaticResource TextPrimary}"
                          BorderBrush="{StaticResource PanelBorder}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter Property="Padding" Value="8,5" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        Padding="14"
                        Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <ProgressBar x:Name="RenderProgressBar"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0" />
                        <Grid Margin="0,9,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WorkerProgressText"
                                       Foreground="{StaticResource TextPrimary}"
                                       Text="0 / 0 帧 · 0%" />
                            <TextBlock x:Name="WorkerSpeedText"
                                       Grid.Column="1"
                                       Foreground="{StaticResource TextSecondary}"
                                       Text="尚未开始" />
                        </Grid>
                        <TextBlock x:Name="SummaryText"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}"
                                   Text="选择输出版本、分辨率和 FPS 后生成计划。相同时间轴与高分辨率母帧会自动共享。" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
        </TabItem>
        <TabItem Header="滤镜与装饰">
            <TabControl Background="{StaticResource WindowBackground}" BorderThickness="0">
                <TabItem Header="装饰">
            <Grid Margin="20" Background="{StaticResource WindowBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,10,0" Text="名单模式" />
                    <ComboBox x:Name="RetentionModeBox"
                              Grid.Column="1"
                              SelectionChanged="RetentionModeBox_SelectionChanged" />
                    <CheckBox x:Name="HideBackgroundDecorationsCheckBox"
                              Grid.Column="2"
                              Margin="22,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="True"
                              Checked="RetentionFilter_Changed"
                              Unchecked="RetentionFilter_Changed"
                              Content="隐藏深度 &gt; 0 的背景装饰" />
                    <TextBlock x:Name="RetentionExplanationText"
                               Grid.Column="3"
                               Margin="18,0,0,0"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="RetentionCountText"
                               Grid.Column="4"
                               Margin="18,0,0,0"
                               Foreground="{StaticResource TextSecondary}"
                               Text="尚未载入谱面" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520" MinWidth="390" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ListView x:Name="DecorationRetentionList"
                                  BorderThickness="0"
                                  SelectionChanged="DecorationRetentionList_SelectionChanged"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Margin="4,0,10,0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsListed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="RetentionItem_Checked"
                                                  Unchecked="RetentionItem_Checked" />
                                        <Border Grid.Column="1"
                                                Width="68"
                                                Height="48"
                                                Background="{StaticResource TransparencyGrid}"
                                                BorderBrush="{StaticResource PanelBorder}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Text="{Binding Detail}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Text="{Binding TagText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="230" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource TransparencyGrid}"
                                    BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="DecorationLargePreview"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Grid x:Name="DiagnosticComparisonPanel"
                                          Background="{StaticResource PanelBackground}"
                                          Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Margin="0,0,0,6"
                                                       HorizontalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="包含此贴图" />
                                            <Border Grid.Row="1" Background="{StaticResource TransparencyGrid}">
                                                <Image x:Name="DiagnosticWithImage" Stretch="Uniform" />
                                            </Border>
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Margin="0,0,0,6"
                                                       HorizontalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="不包含此贴图" />
                                            <Border Grid.Row="1" Background="{StaticResource TransparencyGrid}">
                                                <Image x:Name="DiagnosticWithoutImage" Stretch="Uniform" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                <TextBlock x:Name="DecorationPreviewTitle"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="从左侧选择一张贴图" />
                                <TextBlock x:Name="DecorationPreviewDetails"
                                           Margin="0,5,0,0"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="棋盘格可以同时看清透明、白色、灰色和黑色内容。" />
                            </StackPanel>
                            <Grid Grid.Row="2" Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="GenerateDecorationComparisonButton"
                                        Style="{StaticResource RenderActionButtonStyle}"
                                        Padding="14,7"
                                        Click="GenerateDecorationComparison_Click"
                                        Content="生成 10 个有/无贴图对照" />
                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <CheckBox x:Name="DiagnosticTrackCheckBox"
                                              IsEnabled="False"
                                              ToolTip="独立 Worker 的原版轨道适配完成后开放；当前不会伪装成已生效。"
                                              Content="轨道（待适配）" />
                                    <CheckBox x:Name="DiagnosticPlanetsCheckBox"
                                              IsEnabled="False"
                                              ToolTip="独立 Worker 的原版星球适配完成后开放；当前不会伪装成已生效。"
                                              Content="星球（待适配）" />
                                    <CheckBox x:Name="DiagnosticEffectsCheckBox"
                                              ToolTip="使用独立 Worker 的离线近似滤镜；适合诊断，不能保证与游戏逐像素一致。"
                                              Content="滤镜（离线预览）" />
                                </StackPanel>
                                <TextBlock x:Name="DecorationDiagnosticStatusText"
                                           Grid.Column="2"
                                           Margin="12,0,0,0"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="选择装饰后可从调用时刻 +1 ms 开始，每隔 1 秒生成一对。" />
                            </Grid>
                            <ListBox x:Name="DecorationComparisonList"
                                     Grid.Row="3"
                                     BorderThickness="0"
                                     Background="{StaticResource InputBackground}"
                                     SelectionChanged="DecorationComparisonList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="190" Margin="5">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding TimestampLabel}" />
                                            <Grid Height="86" Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{StaticResource TransparencyGrid}">
                                                    <Image Source="{Binding WithImage}" Stretch="Uniform" />
                                                </Border>
                                                <Border Grid.Column="2" Background="{StaticResource TransparencyGrid}">
                                                    <Image Source="{Binding WithoutImage}" Stretch="Uniform" />
                                                </Border>
                                            </Grid>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock HorizontalAlignment="Center" FontSize="12" Text="包含此贴图" />
                                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="12" Text="不包含此贴图" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
                </TabItem>
                <TabItem Header="滤镜">
                    <Grid Margin="20" Background="{StaticResource WindowBackground}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="23" FontWeight="SemiBold" Text="滤镜归属" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap"
                                       Text="默认保留实时：滤镜仍由游戏处理。烤入视频：独立 Worker 预渲染，并在派生谱面中自动关闭。忽略：不渲染，并在派生谱面中关闭。原谱永不修改。" />
                        </StackPanel>
                        <Border Grid.Row="2"
                                Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <DataGrid x:Name="FilterOwnershipGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      SelectionMode="Single"
                                      IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="190" Header="滤镜" Binding="{Binding DisplayName}" IsReadOnly="True" />
                                    <DataGridTextColumn Width="100" Header="类别" Binding="{Binding EventKind}" IsReadOnly="True" />
                                    <DataGridTextColumn Width="100" Header="平面" Binding="{Binding Plane}" IsReadOnly="True" />
                                    <DataGridTextColumn Width="150" Header="作用对象" Binding="{Binding TargetDescription}" IsReadOnly="True" />
                                    <DataGridTextColumn Width="80" Header="首次格" Binding="{Binding FirstFloor}" IsReadOnly="True" />
                                    <DataGridTextColumn Width="70" Header="次数" Binding="{Binding InvocationCount}" IsReadOnly="True" />
                                    <DataGridTemplateColumn Width="180" Header="处理方式">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox MinWidth="155"
                                                          ItemsSource="{Binding OwnershipChoices}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding Ownership, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="*" Header="离线状态" Binding="{Binding OfflineStatus}" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <TextBlock x:Name="FilterOwnershipSummaryText"
                                   Grid.Row="4"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="尚未载入谱面。" />
                    </Grid>
                </TabItem>
            </TabControl>
        </TabItem>
        <TabItem Header="设置">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Text="设置" />
                    <TextBlock Margin="0,5,0,18"
                               Foreground="{StaticResource TextSecondary}"
                               Text="后续功能设置会继续放在这个独立页面。" />
                    <GroupBox Header="预渲染缓存">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="装饰有/无对照图" />
                                <TextBlock Margin="0,5,20,0"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="删除本工具生成的诊断 JPG 与临时对照视频；不会删除正式输出、派生谱面、源谱或素材。" />
                                <TextBlock x:Name="PreRenderCacheStatusText"
                                           Margin="0,8,20,0"
                                           Foreground="{StaticResource TextSecondary}"
                                           Text="尚未检查。" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Padding="16,9"
                                    VerticalAlignment="Center"
                                    Click="DeletePreRenderedImages_Click"
                                    Content="删除所有预渲染图" />
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
